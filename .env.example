# Future adapters. Never commit real credentials.
# Gemini via AI Studio — shareable. https://aistudio.google.com/apikey
# If this is set, the backend uses it and ignores Vertex / gcloud login.
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional laptop-only Vertex (ADC). Leave these blank when using GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
NESSIE_API_KEY=
SHOPPING_API_KEY=

# Future adapters. Never commit real credentials.
GEMINI_API_KEY=
# Optional: use Vertex AI instead (billed to a Google Cloud project, e.g. the $300 trial credit).
# Either a Vertex express-mode key, or ADC (`gcloud auth application-default login`) plus project.
GOOGLE_GENAI_USE_VERTEXAI=
VERTEX_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=
NESSIE_API_KEY=
SHOPPING_API_KEY=

# Keep demo households available. Set 0 to start without auto-seeding demo data.
RTR_SEED_DEMO=1

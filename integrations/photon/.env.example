# Photon adapter settings. Put real values in the repo-root .env (loaded first);
# an optional integrations/photon/.env is loaded after it and does not override.
# Never commit real credentials.

# Required unless MOCK=1. From https://app.photon.codes (Spectrum Cloud project).
PHOTON_PROJECT_ID=
PHOTON_PROJECT_SECRET=

# Python backend base URL.
BACKEND_URL=http://127.0.0.1:8000

# --- Optional additions (all have defaults) ---

# Identifies this process to /messages/outbound/claim. Default: photon-<hostname>-<pid>.
WORKER_ID=
# Outbound claim loop interval and batch size.
OUTBOUND_POLL_MS=1000
OUTBOUND_CLAIM_MAX=10
# Comma-separated handles that belong to the agent itself (E.164 or email).
# Messages from these are never forwarded. Dedicated-line numbers are detected
# automatically; this is a belt-and-braces extra.
PHOTON_SELF_HANDLES=
# Allow forwarding inbound group-chat messages and sending outbound jobs into
# group chats (by conversation_id). Requires a dedicated Photon line; shared
# (free) lines are DM-only. Default 0 = DMs only.
PHOTON_ENABLE_GROUPS=0
# Run without Photon: stdin lines "+15551234567: text" become inbound, outbound
# jobs print to stdout. Same as `npm run mock`.
MOCK=0
# Adapter log level: debug | info | warn | error.
LOG_LEVEL=info
